# Copy to .env.production and fill in. Never commit .env.production.
# deploy/bootstrap.sh does all of this for you on a fresh server.

APP_NAME=Taskly
APP_ENV=production
APP_DEBUG=false
# Generate with:  echo base64:$(openssl rand -base64 32)
APP_KEY=
# Public URL of the site (used in reminder emails). https://yourdomain.com once you have a domain.
APP_URL=http://YOUR_SERVER_IP

# ":80" = plain HTTP on the server IP. A domain name = automatic HTTPS (DNS A record must already point here).
SITE_ADDRESS=:80

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taskly
DB_USERNAME=taskly
# Generate with:  openssl rand -hex 24
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Tokens expire after 30 days (minutes). Rate limits per minute:
SANCTUM_TOKEN_EXPIRATION=43200
AUTH_THROTTLE_PER_MINUTE=20
API_THROTTLE_PER_MINUTE=240

# Email: reminders are also sent by email. "log" only writes them to the log - switch to SMTP to deliver them.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=reminders@yourdomain.com
# MAIL_FROM_NAME=Taskly
