# syntax=docker/dockerfile:1
# Production image: Caddy + PHP (FrankenPHP) serving the Laravel API and the built Vue SPA.
# Build:  docker build -f Dockerfile.prod -t taskly:prod .
# (Day-to-day development keeps using ./Dockerfile and docker-compose.yml.)

# ---- 1. build the frontend -------------------------------------------------------------------
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY vite.config.ts tsconfig.json ./
COPY resources ./resources
COPY public ./public
RUN npm run build

# ---- 2. PHP dependencies (no dev packages) -----------------------------------------------------
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs

# ---- 3. runtime ---------------------------------------------------------------------------------
FROM dunglas/frankenphp:1-php8.4 AS runtime
WORKDIR /app

RUN install-php-extensions pdo_pgsql intl zip bcmath pcntl opcache \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY deploy/php.ini "$PHP_INI_DIR/conf.d/zz-taskly.ini"
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY --from=vendor /app/vendor ./vendor
COPY . .
COPY --from=assets /app/public/build ./public/build
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY deploy/entrypoint.sh /usr/local/bin/taskly-entrypoint
RUN chmod +x /usr/local/bin/taskly-entrypoint

RUN composer dump-autoload --optimize --no-dev --classmap-authoritative \
    && php artisan package:discover --ansi \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    # Run unprivileged: the web server may bind :80/:443 and write its certificate store.
    && useradd --system --create-home --shell /usr/sbin/nologin taskly \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R taskly:taskly /app/storage /app/bootstrap/cache /data /config

USER taskly
ENV APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr
EXPOSE 80 443 443/udp
# Port 80 is open in both modes (plain HTTP, or HTTPS-redirect + ACME challenge for a domain).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD php -r '$s = @fsockopen("127.0.0.1", 80, $e, $m, 3); exit($s ? 0 : 1);'
ENTRYPOINT ["taskly-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
