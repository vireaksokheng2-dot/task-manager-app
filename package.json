{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "e2e": "bash scripts/e2e.sh",
        "e2e:fast": "E2E_SKIP_SLOW=1 bash scripts/e2e.sh",
        "serve": "HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose up -d --build && echo \"\\nTaskly: http://localhost:8000\"",
        "start:dev": "HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose --profile dev up -d --build && echo \"\\nTaskly: http://localhost:8000 (Vite HMR on :5173)\"",
        "stop": "docker compose --profile dev down && rm -f public/hot",
        "logs": "docker compose --profile dev logs -f --tail=50"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.56.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.20.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.6.0",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.0.0",
        "vitest": "^5.1.1",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "pinia": "^3.0.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    }
}
