# Environment for the end-to-end test instance (APP_ENV=e2e, port 8001, database taskmanager_e2e).
# It is isolated from your dev data and has relaxed rate limits because the suite
# creates many throw-away users.
#
# APP_KEY below is a THROWAWAY key used only by this test instance (fake data, port 8001).
# It lives here because `php artisan serve` blanks real env vars for its worker, so the
# worker can only read keys from this file. Never reuse it anywhere real.
APP_NAME=Taskly
APP_ENV=e2e
APP_KEY=base64:i9+nkb7Kcxw8p7sL4mfl1tIo4DQ/hiP2sm1rX7CH8pg=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taskmanager_e2e
DB_USERNAME=taskmanager
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BCRYPT_ROUNDS=4

AUTH_THROTTLE_PER_MINUTE=100000
API_THROTTLE_PER_MINUTE=100000
